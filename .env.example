# Neon Postgres (read-only role used by the app at runtime)
DATABASE_URL=
# Neon admin connection, used only by scripts/seed.ts (never exposed to the app)
DATABASE_URL_ADMIN=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Password for the app's read-only DB role (16+ chars: letters, digits, _ or - only)
READONLY_PASSWORD=

# --- Rate limits and spend cap (T10). All optional; defaults shown. ---
# Shared counter store (Upstash Redis). REQUIRED on Vercel for /api/suggest to work at all:
# without it the route refuses requests so the Anthropic key can never be used unprotected.
# The Vercel Marketplace Upstash integration injects these (or the KV_REST_API_URL / KV_REST_API_TOKEN names).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hard cap on LLM spend per UTC day, in US dollars (default 0.5, about 1,500 questions on Haiku).
DAILY_SPEND_CAP_USD=
# Per-visitor request limits (defaults: 10/min and 100/day for suggest, 30/min and 300/day for run).
SUGGEST_PER_MIN=
SUGGEST_PER_DAY=
RUN_PER_MIN=
RUN_PER_DAY=
